generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User{
  id String @id @default(cuid())
  name String?
  email String @unique
  bookmarks Bookmark[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bookmark{
  id String @id @default(cuid())
  title String
  url String
  tags Tag[]
  userId String
  user User @relation(fields: [userId],references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag{
  id String @id @default(cuid())
  name String
  bookmarks Bookmark[]
  createdAt DateTime @default(now())
}